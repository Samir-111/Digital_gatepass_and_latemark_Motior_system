# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:5000"

# Firebase Cloud Firestore Configurations
FIREBASE_PROJECT_ID="your_firebase_project_id_here"
FIRESTORE_DATABASE_ID="(default)"
GOOGLE_APPLICATION_CREDENTIALS="./firebase-service-account.json"

# Fast2SMS Dev API Authorization Key for real parent SMS dispatch
FAST2SMS_API_KEY="YOUR_FAST2SMS_API_KEY"

# Green API WhatsApp Gateway Configurations
GREEN_API_URL="https://7107.api.greenapi.com"
GREEN_API_INSTANCE_ID="710722683037"
GREEN_API_TOKEN="YOUR_GREEN_API_TOKEN"

# MongoDB Atlas Database Configuration (Replaces Firebase)
MONGODB_URI="mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/college_gatepass?retryWrites=true&w=majority"
